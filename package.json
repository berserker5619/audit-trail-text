{
  "name": "audit-trail-text",
  "version": "1.4.0",
  "description": "Diff two versions of a JSON record against its JSON Schema: structured changes with stable codes, and one plain sentence per change.",
  "keywords": [
    "audit",
    "audit-trail",
    "audit-log",
    "activity-feed",
    "diff",
    "json-schema",
    "changelog",
    "history",
    "change-tracking",
    "mongoose",
    "mongoose-plugin",
    "change-streams"
  ],
  "homepage": "https://github.com/berserker5619/audit-trail-text#readme",
  "bugs": {
    "url": "https://github.com/berserker5619/audit-trail-text/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berserker5619/audit-trail-text.git"
  },
  "license": "MIT",
  "author": "Nizamudeen S",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mongoose": {
      "types": "./dist/mongoose/index.d.ts",
      "default": "./dist/mongoose/index.js"
    },
    "./mongo": {
      "types": "./dist/mongo/index.d.ts",
      "default": "./dist/mongo/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.mongoose.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "check:bundle": "node scripts/check-bundle.mjs",
    "golden:update": "node test/golden.test.ts --update",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:mongoose && npm run test:mongo && npm run build && npm run check:bundle",
    "test:mongoose": "node --test \"test/mongoose/*.mongoose.ts\"",
    "test:mongo": "node --test \"test/mongo/*.mongo.ts\""
  },
  "peerDependencies": {
    "mongoose": "^7 || ^8 || ^9"
  },
  "peerDependenciesMeta": {
    "mongoose": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^9.11.3",
    "typescript": "^7.0.2"
  }
}
