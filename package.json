{
  "name": "audit-trail-text",
  "version": "1.0.0-rc.1",
  "description": "Diff two versions of a JSON record against its JSON Schema: structured changes with stable codes, and one plain sentence per change.",
  "keywords": [
    "audit",
    "audit-trail",
    "audit-log",
    "activity-feed",
    "diff",
    "json-schema",
    "changelog",
    "history",
    "change-tracking"
  ],
  "homepage": "https://github.com/berserker5619/audit-trail-text#readme",
  "bugs": {
    "url": "https://github.com/berserker5619/audit-trail-text/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berserker5619/audit-trail-text.git"
  },
  "license": "MIT",
  "author": "Nizamudeen S",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "check:bundle": "node scripts/check-bundle.mjs",
    "golden:update": "node test/golden.test.ts --update",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:bundle"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2"
  }
}
